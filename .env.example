# Optional: pre-configure provider API keys on the server.
# You can also leave these empty and enter keys directly in the browser UI (BYOK encrypted cookie).

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Optional custom OpenAI-compatible endpoint (e.g., Ollama, LiteLLM, vLLM)
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_API_KEY=ollama
# CUSTOM_MODELS=llama3.3,qwen2.5

# Optional: fixed secret for encrypting BYOK cookies across restarts (auto-generated into .turing_secret if unset)
# TURING_COOKIE_SECRET=
